DATABASE_URL=postgresql://user:password@localhost:5432/mydb
# минимум 32 символа, сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-of-32-plus-chars
PORT=4000
# разрешённые origins через запятую
CORS_ORIGINS=http://localhost:4000,http://localhost:5173
